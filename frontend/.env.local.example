# Google Gemini API キー（無料版で無制限・即時利用可能）
# 取得先（Google AI Studio）: https://aistudio.google.com/app/apikey
# 
# 取得したAPIキー（AIzaSy...）を以下に設定し、本ファイルを「.env.local」にコピーして保存してください。
# 設定すると、ブラウザごとにキーを入力することなくサーバーサイドで自動認識されます。

GEMINI_API_KEY=

# 管理者コード（メンテナンス管理画面の認証に使用。サーバー側でのみ参照）
# 未設定の場合、管理者認証はすべて拒否されます。
# ブラウザに公開されるため、NEXT_PUBLIC_ を付けないでください。
ADMIN_SECRET_KEY=

# メンテナンス設定の保存先（Upstash Redis）。Vercelでは連携時に自動で設定されます。
# 未設定の場合、設定はメモリとローカルファイルにだけ保存され、再デプロイで元に戻ります。
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# アカウントのログイン情報もRedis（上と同じ）に保存します。Vercel上でRedisが未設定だとログイン・登録ができません。

# パスワード再設定・ログインID確認のメール送信（未設定のローカル開発では、送信内容をサーバーのログに出します）
# MAIL_PROVIDER=resend
# RESEND_API_KEY=
# MAIL_FROM=エネコマ <noreply@example.com>
# メールのリンクのドメイン（未設定ならVercelの本番URL）
# APP_BASE_URL=https://enekoma.vercel.app
